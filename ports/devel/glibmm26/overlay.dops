port devel/glibmm26
type port
target @any
reason "Update glibmm26 to 2.88.1 for GNOME 50 C++ bindings"

mk set PORTVERSION "2.88.1"
mk set USES "compiler:c++17-lang gettext gnome meson perl5 pkgconfig python:build shebangfix tar:xz"
mk set USE_CXXSTD "c++17"
mk set MESON_ARGS "-Dbuild-documentation=false -Dbuild-examples=false"
mk set USE_GCC_VERSION "13"
file materialize dragonfly/distinfo -> distinfo
