port graphics/eog
type port
target @any
reason "EOG 50.2 matches the GNOME 50 desktop stack; librsvg 2.60 satisfies the upstream requirement"

mk set DISTVERSION "50.2"
mk set PORTSCOUT "limit:^50\\."
mk target remove dfly-patch on-missing error
file materialize distinfo -> distinfo
file materialize pkg-plist -> pkg-plist
