port editors/editorconfig-core-c
type port
reason "Migrate editorconfig-core-c DragonFly compat and fix the GCC 8 strncpy warning under upstream -Werror"
target @any

mk eval BUILD_DEPENDS "${BUILD_DEPENDS:Ndoxygen*}"
mk set DFLY_PLIST "${WRKSRC}/pkg-plist"
mk set PLIST "${DFLY_PLIST}"
mk target set dfly-patch <<'MK1'
	${CP} -v ${.CURDIR:H}/editorconfig-core-c/pkg-plist ${DFLY_PLIST}
	${REINPLACE_CMD} -e '/man\/man/d' ${DFLY_PLIST}
MK1
file materialize files/patch-src_lib_ini.c -> files/patch-src_lib_ini.c
