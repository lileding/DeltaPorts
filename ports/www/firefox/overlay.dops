port www/firefox
type port
target @any
reason "firefox 152 on DragonFly, Wayland. Builds and runs (firefox --version -> 152.0). Main compiler is ports GCC 13 (USE_GCC_VERSION=13): firefox 152 needs C++20 library headers (<version>/<bit>) that DragonFly's clang-default base gcc 8.3 libstdc++ lacks; gcc13 has them and satisfies firefox's >=10.1 requirement. clang (llvm) is still used for bindgen/wasm via --with-clang-path + BINARY_ALIAS. The wayland-probe sabotage (gtk+-wayland -> waylandz) is dropped so the default wayland gtk3 toolkit builds; webrtc off (sctp); LTO off. Source ports live in dragonfly/ (profiler lwp_gettid/lwp_kill + no-LUL, abseil, mtu cfg, ffvpx getauxval, sqlite -lm, SharedMemory MAP_NORESERVE, libc IP_RECVTOS, libxul memalign/valloc ignore-unresolved). BUILD ORCHESTRATION not yet fully automated (see NOTES.dragonfly): (1) pass CC/CXX/CPP=gcc13 g++13 cpp13 explicitly; (2) bindgen needs a gcc13 C++ header shim (full gcc13 include/c++ tree with throw()/_GLIBCXX_NOTHROW stripped from cstdlib/cwchar/cstdio/cwctype) injected as -nostdinc++ -isystem into BINDGEN_SYSTEM_FLAGS, since clang can't parse DragonFly libc + gcc13 exception specs otherwise; (3) the wasm2c host tool and the installed firefox launcher need LD_LIBRARY_PATH=/usr/local/lib/gcc13 (gcc13 libstdc++.so.6 has GLIBCXX_3.4.31; ld hints prefer gcc11) and the launcher also needs /usr/local/lib/firefox + MOZ_ENABLE_WAYLAND=1; (4) MAKE_JOBS_NUMBER<=12 to avoid OOM at 32 threads on 32GB."

mk set USE_GCC_VERSION "13"

mk eval OPTIONS_DEFAULT "${OPTIONS_DEFAULT:NLTO}"

mk add MOZ_OPTIONS "--disable-webrtc"
mk add MOZ_OPTIONS "--enable-forkserver"
mk add BINARY_ALIAS "clang=${LOCALBASE}/llvm${LLVM_DEFAULT}/bin/clang clang++=${LOCALBASE}/llvm${LLVM_DEFAULT}/bin/clang++ wasm-ld=${LOCALBASE}/llvm${LLVM_DEFAULT}/bin/wasm-ld"

mk target append post-patch <<'MK'
	${REINPLACE_CMD} -e 's|MOZ_SCTP|MOZ_DISABLE_SCTP|' \
		${WRKSRC}/netwerk/moz.build
	${REINPLACE_CMD} -e 's|<math.h>|<cmath>|' \
		${WRKSRC}/gfx/angle/checkout/src/compiler/translator/InfoSink.h \
		${WRKSRC}/gfx/angle/checkout/src/compiler/translator/IntermNode.cpp
	${REINPLACE_CMD} -e 's@_XOPEN_SOURCE@&___@g' \
		${WRKSRC}/media/libcubeb/src/cubeb_alsa.c
	${REINPLACE_CMD} -e 's@_POSIX_SOURCE@&___@g' \
		${WRKSRC}/media/libcubeb/src/cubeb_jack.cpp
MK

