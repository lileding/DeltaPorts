file materialize dragonfly/patch-toolkit_modules_Troubleshoot.sys.mjs -> files/patch-toolkit_modules_Troubleshoot.sys.mjs# --- DragonFly build orchestration folded into the port (option A) ---
# firefox's main compiler must be gcc13 consistently: configure, the recursive
# make, AND the cargo cc-crate build scripts (swgl/mozglue-static). Setting CC
# here (before bsd.gecko.mk) stops gecko.mk from forcing clang when CC==cc, so
# cargo picks gcc13 which ships C++20 (<version>) natively -- no shim needed for
# the compiles, only for bindgen's libclang (see post-configure below).
mk set CC "${LOCALBASE}/bin/gcc13"
mk set CXX "${LOCALBASE}/bin/g++13"
mk set CPP "${LOCALBASE}/bin/cpp13"

# gcc13 host tools (wasm2c) need gcc13's libstdc++.so.6 (GLIBCXX_3.4.31); ld
# hints otherwise resolve to gcc11 first.
mk add MAKE_ENV "LD_LIBRARY_PATH=${LOCALBASE}/lib/gcc13:${LOCALBASE}/lib"

# Build the bindgen C++ header shim: gcc13's C++ tree with throw()/
# _GLIBCXX_NOTHROW stripped from the 4 headers whose exception specs libclang
# cannot reconcile with DragonFly libc.
mk target set pre-configure <<'MK'
	@${MKDIR} ${WRKDIR}/ff-cxx13
	${CP} -a ${LOCALBASE}/lib/gcc13/include/c++/* ${WRKDIR}/ff-cxx13/
	@for h in cstdlib cwchar cstdio cwctype; do \
		${REINPLACE_CMD} -e 's/throw ()//g' -e 's/_GLIBCXX_NOTHROW//g' ${WRKDIR}/ff-cxx13/$$h ; \
	done
MK

# Inject the shim into the generated BINDGEN flags (JSON substs read by the
# mozbuild crate, plus autoconf.mk for the make-level bindgen). Runs every
# configure, so it survives reconfigure -- unlike the old manual injection.
mk target set post-configure <<'MK'
	@cd ${WRKDIR}/.build && ${LOCALBASE}/bin/python3.11 -c 'import json; f="config.statusd/substs/BINDGEN_SYSTEM_FLAGS"; a=json.load(open(f)); a=[x for x in a if "ff-cxx13" not in x]; shim=["-nostdinc++","-isystem","${WRKDIR}/ff-cxx13","-isystem","${WRKDIR}/ff-cxx13/x86_64-portbld-dragonfly6.5","-isystem","${WRKDIR}/ff-cxx13/backward"]; json.dump(a+shim, open(f,"w"), indent=4)'
	@${REINPLACE_CMD} -e 's|BINDGEN_SYSTEM_FLAGS = |BINDGEN_SYSTEM_FLAGS = -nostdinc++ -isystem ${WRKDIR}/ff-cxx13 -isystem ${WRKDIR}/ff-cxx13/x86_64-portbld-dragonfly6.5 -isystem ${WRKDIR}/ff-cxx13/backward |' ${WRKDIR}/.build/config/autoconf.mk
MK

# e10s multiprocess is left enabled: the old nsAppRunner force-disable patch
# is dropped, since its 2020-era slowness/crashes no longer reproduce on the
# gcc13 firefox 152 build. Fission (site isolation) is defaulted off instead:
# per-site content-process spawning hits a fork/pthread-atfork crash and is
# slow on DragonFly. e10s alone fixes DOM fullscreen and session restore.
mk add PLIST_FILES "lib/firefox/defaults/pref/dragonfly.js"
file materialize dragonfly/dragonfly.js -> files/dragonfly.js
mk target append post-install <<'MK'
	${INSTALL_DATA} ${FILESDIR}/dragonfly.js \
		${STAGEDIR}${PREFIX}/lib/firefox/defaults/pref/dragonfly.js
MK
file materialize dragonfly/patch-ipc_glue_ForkServer.cpp -> files/patch-ipc_glue_ForkServer.cpp
file materialize dragonfly/patch-toolkit_moz.configure -> files/patch-toolkit_moz.configure

# Enable remote media decoding on DragonFly. StaticPrefList.yaml gates the RDD
# and Utility process media prefs on XP_FREEBSD (plus WIN/MACOSX/LINUX/OPENBSD/
# SOLARIS), but DragonFly has no XP_* platform macro of its own -- only XP_UNIX
# -- so all seven prefs fell through to the #else and defaulted to false.
# media.utility-process.enabled is additionally Preferences::Lock()-ed at
# runtime (MediaDecoder.cpp), so no user pref can restore it. With the remote
# decoders off, content processes report zero codecs and all HTML5 video fails.
#
# init.configure gains an XP_DRAGONFLY define (mirroring XP_FREEBSD), and the
# seven prefs add "|| defined(XP_DRAGONFLY)" so DragonFly defaults like FreeBSD:
# RDD decodes video, Utility decodes audio. The StaticPrefList #if is evaluated
# by mozbuild Preprocessor against ALLDEFINES, so it needs a real build define
# (XP_DRAGONFLY), not the compiler builtin __DragonFly__.
file materialize dragonfly/patch-build_moz.configure_init.configure -> files/patch-build_moz.configure_init.configure
file materialize dragonfly/patch-modules_libpref_init_StaticPrefList.yaml -> files/patch-modules_libpref_init_StaticPrefList.yaml

# rtld lazy-binding freeze mitigation: ship bin/firefox as a wrapper script
# (LD_BIND_NOW=1 + libvpx/libdav1d preload) instead of the symlink to the
# real binary. DragonFly rtld ignores DT_BIND_NOW, and lazy PLT binding under
# multiprocess load serializes on the rtld global lock (~30s UI freezes on
# the first heavy page/video). Full rationale in files/firefox.sh.
file materialize dragonfly/firefox.sh -> files/firefox.sh
mk target append post-install <<'MK'
	${RM} ${STAGEDIR}${PREFIX}/bin/firefox
	${INSTALL_SCRIPT} ${FILESDIR}/firefox.sh ${STAGEDIR}${PREFIX}/bin/firefox
MK
